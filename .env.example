# Copy to .env and fill in. .env is git-ignored.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="portfolio"
# Long random string, e.g. `openssl rand -base64 48`
SESSION_SECRET=""

# Public site URL, used for the Google sign-in redirect (e.g. https://lamaparbat.com.np).
SITE_URL=""
# "Sign in with Google" for likes and comments. Create an OAuth client (Web application) at
# https://console.cloud.google.com/apis/credentials and add <SITE_URL>/api/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
